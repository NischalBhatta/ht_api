# Habit Tracker API

@baseURL = http://localhost:8000/api/v1/habits

@compURL = http://localhost:8000/api/v1/completions


### POST REQUEST
POST {{baseURL}}
Content-Type: application/json

{
  "name": "WALK",
  "color": "#ffff",
  "isArchived": false
}


### GET Request
GET {{baseURL}}


### PATCH REQUEST
PATCH {{baseURL}}
Content-Type: application/json

{
  "_id":"6a8e5f1ec95faa9b50133e11",
  "isArchived": true
}


### DELETE REQUEST
DELETE {{baseURL}}
Content-Type: application/json

{
  "_id": "6a8d3a6322c6c8ccc9c57650"
}


### POST COMPLETION REQUEST
POST {{compURL}}
Content-Type: application/json

{
  "habitId": "6a87eff36d546bfd3edca7e2",
  "completedOn": "2026-09-07T03:35:58.516Z"
}

###Get Completion Request
GET {{compURL}}?habitId=6a9834df724640c40fa1533b


###Delete Completion Request
DELETE {{compURL}}
Content-Type: application/json

{
  "habitId": "6a87eff36d546bfd3edca7e2"
}


